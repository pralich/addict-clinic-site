{
  "tests": [
    {
      "name": "Health",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Wrong token",
      "method": "POST",
      "path": "/",
      "body": {
        "cmd": "history",
        "crm_token": "wrong",
        "callid": "x"
      },
      "expectedStatus": 401
    },
    {
      "name": "Event wrong token",
      "method": "POST",
      "path": "/",
      "body": {
        "cmd": "event",
        "type": "INCOMING",
        "crm_token": "wrong",
        "callid": "x"
      },
      "expectedStatus": 401
    },
    {
      "name": "Sync requires CRM login",
      "method": "POST",
      "path": "/?cmd=sync",
      "body": {},
      "expectedStatus": 401
    },
    {
      "name": "Autosync wrong key",
      "method": "POST",
      "path": "/",
      "body": {
        "cmd": "autosync",
        "key": "wrong"
      },
      "expectedStatus": 401
    }
  ]
}