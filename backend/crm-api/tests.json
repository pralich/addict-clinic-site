{
  "tests": [
    {
      "name": "Dictionaries",
      "method": "GET",
      "path": "/?resource=dictionaries",
      "expectedStatus": 200,
      "expectedBody": {
        "deal_stages": [
          "new",
          "consult",
          "diagnostics",
          "offer",
          "treatment",
          "won",
          "lost"
        ]
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Lead without key",
      "method": "POST",
      "path": "/?resource=leads",
      "body": {
        "contact": "+79990000000"
      },
      "expectedStatus": 401
    },
    {
      "name": "Wrong key",
      "method": "POST",
      "path": "/?resource=clients",
      "headers": {
        "X-Api-Key": "wrong"
      },
      "body": {
        "full_name": "Тест"
      },
      "expectedStatus": 401
    },
    {
      "name": "Unknown resource",
      "method": "GET",
      "path": "/?resource=unknown",
      "expectedStatus": 404
    },
    {
      "name": "Site lead without consent",
      "method": "POST",
      "path": "/?resource=site_lead",
      "body": {
        "contact": "+79990000000"
      },
      "expectedStatus": 400
    },
    {
      "name": "Site lead honeypot",
      "method": "POST",
      "path": "/?resource=site_lead",
      "body": {
        "contact": "x",
        "website": "spam"
      },
      "expectedStatus": 200
    },
    {
      "name": "Track visit",
      "method": "POST",
      "path": "/?resource=track",
      "body": {
        "session": "test-session-1",
        "visitor": "test-visitor-1",
        "path": "/",
        "title": "Тест",
        "pages": [
          {
            "path": "/",
            "title": "Тест",
            "at": 1,
            "sec": 3
          }
        ],
        "active_seconds": 3
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    }
  ]
}